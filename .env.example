DATABASE_URL=postgresql+psycopg2://taskhub:taskhub@localhost:5432/taskhub

# Generate a real one for local dev with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=insecure-dev-secret-change-me-before-deploying-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser (frontend dev servers, etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
